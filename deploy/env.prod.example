# Production configuration for deploy/compose.prod.yaml.
#
#   cp env.prod.example .env.prod     # then fill it in
#   docker compose -f compose.prod.yaml --env-file .env.prod up -d
#
# The copy you fill in is git-ignored and must stay that way. Nothing in this
# file is a real value; every CHANGE-ME must be replaced before it will start.
#
# A missing variable fails at `docker compose up` with the variable named,
# because the compose file uses the `:?` form. That is deliberate: production
# should fail to start rather than start misconfigured.

# --- database --------------------------------------------------------------
DB_NAME=workin
DB_USER=workin
DB_PASSWORD=CHANGE-ME-openssl-rand-base64-24
DB_ROOT_PASSWORD=CHANGE-ME-different-from-DB_PASSWORD

# --- the signing secret, and the one to get wrong at your peril ------------
# R-024. This MUST equal the PHP deployment's AppConfig::JWT_SECRET. Get it
# wrong and every token on every user's device stops working: they are logged
# out at cutover, and again when the refresh token is rejected.
#
# The application logs a FINGERPRINT of this value at startup, never the value.
# Compare that fingerprint against PHP's before opening the cutover window --
# docs/operations/verifying-the-signing-secret.md.
JWT_SECRET=CHANGE-ME-must-match-the-PHP-deployment-exactly

# --- WhatsApp (OTP delivery) -----------------------------------------------
# Required in production. Unset means every OTP-issuing route answers 503,
# which silently breaks registration, password reset and phone change.
WHATSAPP_API_TOKEN=CHANGE-ME
WHATSAPP_INSTANCE_ID=CHANGE-ME

# --- platform admin ---------------------------------------------------------
# Base64 of exactly 32 bytes (AES-256):  openssl rand -base64 32
# Losing this makes every enrolled second factor unverifiable, so it belongs
# wherever the database password belongs, not only on the VPS.
ADMIN_MFA_KEY=CHANGE-ME-openssl-rand-base64-32

# The first administrator. Optional: unset means none is created.
ADMIN_PHONE=
ADMIN_PASSWORD=

# ADR-0015 prerequisite 7. Leave false until the legacy PHP admin surface is
# confirmed UNREACHABLE. Turning it on while PHP is still up lets an attacker
# walk around the MFA and step-up design by using the weaker surface instead.
ADMIN_ACTIONS_ENABLED=false

# --- ports and sizing -------------------------------------------------------
# Both are bound to loopback by the compose file; a reverse proxy on the host
# terminates TLS and forwards to APP_PUBLISHED_PORT.
APP_PUBLISHED_PORT=8080
DB_PUBLISHED_PORT=13306
APP_MEMORY_LIMIT=1g
DB_MEMORY_LIMIT=1g
UPLOADS_URL=/uploads/
