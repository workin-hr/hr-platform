# The backend in Docker, against a database that already exists.
# Copy to .env.remote-db (git-ignored) and fill in.
#
# If this points at production: the application will WRITE to it through every
# route a client calls. Keep ADMIN_ACTIONS_ENABLED=false, and remember that the
# password below is a production credential -- it belongs in a password
# manager, not in a terminal history or a chat window.

DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# MUST equal the PHP deployment's AppConfig::JWT_SECRET (R-024). With a
# different value every token already on a device is rejected, which looks
# exactly like a broken login.
JWT_SECRET=

# The dashboard's one password (ADR-0018). Anything you choose: on first start
# the application creates or rotates the single administrator row to match it.
ADMIN_PASSWORD=

# Where the stored uploads already live, ABSOLUTE, with the trailing slash.
# An absolute URL is what tells this application not to serve them.
UPLOADS_URL=https://CHANGE-ME/uploads/

# local | integration
SPRING_PROFILE=local

# Leave false against real data. True lets the dashboard suspend, approve and
# reject real companies.
ADMIN_ACTIONS_ENABLED=false

# Only needed with compose.tls.yaml, which the admin dashboard requires.
APP_DOMAIN=localhost
TLS_EMAIL=you@example.com
