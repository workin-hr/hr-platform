# Shared integration environment for deploy/compose.integration.yaml.
#
#   cp env.integration.example .env.integration    # then fill it in
#   docker compose -f compose.integration.yaml --env-file .env.integration up -d
#
# This environment holds the SANITISED seed and no real customer data. It still
# takes real secrets, because more than one person can reach it: a shared box
# with a committed signing secret is a box anyone can mint tokens for.

DB_NAME=workin
DB_USER=workin
DB_PASSWORD=CHANGE-ME-openssl-rand-base64-24
DB_ROOT_PASSWORD=CHANGE-ME-different-from-DB_PASSWORD

# Required, and deliberately DIFFERENT from production's. A token minted on the
# integration box must not be accepted by production, and the only thing that
# guarantees that is the two secrets not matching.
JWT_SECRET=CHANGE-ME-must-differ-from-production

# The dashboard's one password (ADR-0018), if you intend to use the
# platform-admin surface here. Unset, nobody can sign in.
ADMIN_PASSWORD=

# Leave unset. The seed's phone numbers are synthetic, so a message would go
# nowhere real -- but that depends on the seed being exactly what we think it
# is, and this box is shared. Every OTP route answers 503 while unset, which is
# legacy's own behaviour without credentials.
WHATSAPP_API_TOKEN=
WHATSAPP_INSTANCE_ID=

APP_PUBLISHED_PORT=8080
DB_PUBLISHED_PORT=13306

# Set to `native` ONLY when a reverse proxy terminating TLS is the sole route to
# APP_PUBLISHED_PORT. It makes the application trust X-Forwarded-*; with the port
# reachable directly, anyone can then claim any client address (R-049).
# The admin dashboard needs it, because its session cookie is `secure` and the
# redirects behind the proxy otherwise carry `http`. deploy/e2e sets it.
FORWARD_HEADERS_STRATEGY=none

# Trace sampling. 0.05 by default: the exporter writes spans to the log, so
# 1.0 multiplies log volume by the request rate (ADR-0019). Raise it for an
# incident, lower it afterwards.
APP_TRACE_SAMPLING=0.05
# Database connection pool. 10 is HikariCP's default and what this ran on
# before it was configurable. Size it against MariaDB's max_connections
# divided by the number of application instances -- and note that a bigger
# pool is not automatically faster.
APP_DB_MAX_POOL_SIZE=10
