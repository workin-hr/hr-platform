# Copy to .env and fill in. .env is git-ignored; never commit real values.

# The trial database's own credentials -- these are NOT Hostinger's. Pick
# anything; nothing outside this stack connects to it.
DB_ROOT_PASSWORD=change-me
DB_NAME=workin
DB_USER=workin
DB_PASSWORD=change-me

# Must equal the PHP deployment's AppConfig::JWT_SECRET. If it differs, every
# token already on a user's device stops working. Verify by comparing the
# fingerprint the app logs at startup with PHP's -- see
# docs/operations/verifying-the-signing-secret.md.
JWT_SECRET=

# The first platform administrator, created on first startup if absent.
ADMIN_PHONE=
ADMIN_PASSWORD=

# Admin write actions. Off by default; a trial box is where you turn them on.
ADMIN_ACTIONS_ENABLED=false

# Leave the WhatsApp credentials unset on any box holding a copy of real
# customer data: with them set, testing a password reset sends a real message
# to a real person.
WHATSAPP_API_TOKEN=
WHATSAPP_INSTANCE_ID=

APP_PUBLISHED_PORT=8080
DB_PUBLISHED_PORT=13307
