# Locally generated, never committed: signing secret, minted tokens, app logs,
# and sweep output (which contains real response bodies from the snapshot).
.jwt-secret
.php-token
.php-token-*
.java-token
*.log
sweep-results.txt
sweep-after.txt
sweep-control.txt
auth-diffs.txt
auth-diffs-*.txt
mutation-diffs.txt
# Generated by resolve-params.sh from the seeded snapshot -- ids are specific
# to one seed, so a committed copy would be wrong for anyone else's database.
client-endpoints-authed.txt
params-unresolved.txt
php/uploads/
# The real configs, filled in from the .example templates beside them.
php/constants.php
php/dashboard-constants.php
last-run.txt
