{
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push origin +*)",
      "Bash(git merge*)",
      "Bash(git reset --hard*)",
      "Bash(git branch -D*)",
      "Bash(git branch --delete --force*)",
      "Bash(git clean -f*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.gh-token)",
      "Read(**/*.pem)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./.gh-token)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh pr merge*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/git_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
