+
+/**
+ * الموظف يخص الشركة دي؟ (R-059)
+ *
+ * جدول attendance ملوش company_id: ملكيته للشركة بتيجي من employee_id وحده.
+ * يعني إدخال صف بـemployee_id جاي من الـPOST من غير فحص = كتابة على موظف
+ * شركة تانية. نفس أسلوب org_branch_belongs_to_company().
+ */
+function payroll_employee_belongs_to_company(int $employeeId, int $companyId): bool
+{
+    if ($employeeId <= 0 || $companyId <= 0) {
+        return false;
+    }
+
+    return (int) dbValue(
+        'SELECT COUNT(*) FROM employees WHERE id=? AND company_id=?',
+        [$employeeId, $companyId]
+    ) > 0;
+}
+
+/**
+ * نوع الاستثناء يخص الشركة دي؟ (R-059)
+ *
+ * exception_types ليها company_id، والـAPI بيفحصها عبر
+ * exception_type_validate_id_for_company(). الصفحة ما كانتش بتفحص.
+ */
+function payroll_exception_type_belongs_to_company(int $typeId, int $companyId): bool
+{
+    if ($typeId <= 0 || $companyId <= 0) {
+        return false;
+    }
+
+    return (int) dbValue(
+        'SELECT COUNT(*) FROM exception_types WHERE id=? AND company_id=?',
+        [$typeId, $companyId]
+    ) > 0;
+}
