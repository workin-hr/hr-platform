+/**
+ * الجدول ← الشركة المالكة للصف (R-046).
+ *
+ * جداول شؤون العاملين ترتبط بالشركة بطريقتين: بعضها يحمل company_id مباشرة،
+ * وبعضها يصل إليها عبر employee_id. الخريطة هنا في مكان واحد حتى لا تتكرر
+ * الاستعلامات في كل صفحة.
+ *
+ * @return int|null معرّف الشركة، أو null إذا لم يوجد الصف
+ */
+function hr_row_company_id(string $table, int $id): ?int
+{
+    if ($id <= 0) {
+        return null;
+    }
+
+    $sql = match ($table) {
+        // company_id مباشرة على الصف
+        'assets', 'complaints' =>
+            "SELECT `company_id` FROM `$table` WHERE id = ? LIMIT 1",
+        // عبر الموظف
+        'leave_balance', 'penalties', 'advances', 'requests' =>
+            "SELECT e.company_id
+             FROM `$table` t
+             JOIN employees e ON e.id = t.employee_id
+             WHERE t.id = ? LIMIT 1",
+        default => null,
+    };
+
+    if ($sql === null) {
+        // جدول غير معروف: نرفض بدلاً من السماح.
+        return null;
+    }
+
+    $value = dbValue($sql, [$id]);
+
+    return $value === null ? null : (int) $value;
+}
+
+/**
+ * يرفض أي كتابة على صف يخص شركة أخرى (R-046).
+ *
+ * نفس قاعدة org_verify_post_row() و$decisionRowAllowed() الموجودتين بالفعل:
+ *
+ * - جلسة مقيّدة بشركة (مالك أو HR): الصف لازم يكون تبع شركته.
+ * - مدير المنصة مع فلتر شركة: الصف لازم يكون تبع الشركة المفلترة.
+ * - مدير المنصة بدون فلتر: مسموح — ده معنى "كل الشركات".
+ *
+ * تُستدعى مرة واحدة أعلى بلوك الـPOST، فتغطي كل الإجراءات في الصفحة.
+ */
+function hr_verify_post_row(string $table, int $id, int $cid): void
+{
+    if ($id <= 0) {
+        return;
+    }
+
+    $page = match ($table) {
+        'leave_balance' => 'leave_balances',
+        'penalties'     => 'penalties',
+        'assets'        => 'assets',
+        'advances'      => 'advances',
+        'requests'      => 'requests',
+        'complaints'    => 'complaints',
+        default         => 'index',
+    };
+
+    $rowCid = hr_row_company_id($table, $id);
+    if ($rowCid === null) {
+        flash(__('error_db'), 'error');
+        hr_redirect($page, $cid);
+    }
+
+    if (hr_is_scoped_company()) {
+        if ($rowCid !== (int) (getCurrentCompanyId() ?? 0)) {
+            flash(__('error_db'), 'error');
+            hr_redirect($page, $cid);
+        }
+
+        return;
+    }
+
+    if ($cid > 0 && $rowCid !== $cid) {
+        flash(__('error_db'), 'error');
+        hr_redirect($page, $cid);
+    }
+}
